{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": false,
    "outDir": "../../.verify-dist",
    "baseUrl": "../..",
    "paths": { "@/*": ["./src/*"] },
    "rootDir": "../.."
  },
  "include": ["./**/*.ts", "../../src/lib/**/*.ts"]
}
